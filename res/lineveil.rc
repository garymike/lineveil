#include <windows.h>
#include "version.h"

#define IDI_APP 1

IDI_APP ICON "lineveil.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "lineveil.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LV_VERSION_MAJOR, LV_VERSION_MINOR, LV_VERSION_PATCH, 0
PRODUCTVERSION  LV_VERSION_MAJOR, LV_VERSION_MINOR, LV_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "garymike"
            VALUE "FileDescription",  "Lineveil scanline overlay"
            VALUE "FileVersion",      LV_VERSION_STR
            VALUE "InternalName",     "lineveil"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Michael Gary. MIT License."
            VALUE "OriginalFilename", "lineveil.exe"
            VALUE "ProductName",      "Lineveil"
            VALUE "ProductVersion",   LV_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
